# OpenAI / extraction
OPENAI_API_KEY=
OPENAI_MODEL=
KB_EXTRACTOR=

# Whisper (local transcription)
# Docker/Railway image bakes in small.en on CPU — override only if needed.
WHISPER_MODEL=small.en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE=int8

# Server
PORT=8137

# Legacy shared KB (pre-auth archive only — runtime uses KB_DATA_DIR)
KB_ROOT=./kb

# Per-user knowledge bases (one subdirectory per Supabase user id)
KB_DATA_DIR=./kb-data

# Supabase auth (required when AUTH_DISABLED=false)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Set true for local E2E/tests without Supabase login
AUTH_DISABLED=false

# Optional
GITHUB_TOKEN=
PROMPTS_ROOT=./prompts
