{"nodes": [{"id": "plan_voice_first_kb_v2", "label": "Voice-First KB v2 Implementation Plan", "file_type": "document", "source_file": "docs/superpowers/plans/2026-07-05-voice-first-kb-v2.md", "source_location": null, "source_url": null, "captured_at": "2026-07-05", "author": null, "contributor": null}, {"id": "rationale_okf_format", "label": "OKF Entry Format Design", "file_type": "rationale", "source_file": "docs/superpowers/plans/2026-07-05-voice-first-kb-v2.md", "source_location": "Locked design decisions #1", "source_url": null, "captured_at": "2026-07-05", "author": null, "contributor": null, "rationale": "Uses YAML frontmatter with line-anchored delimiter parsing to prevent corruption when entry titles/bodies contain --- characters. Entry types: note, skill, project, experience, organization, person, source."}, {"id": "rationale_openai_structured_outputs", "label": "OpenAI Structured Outputs Extraction", "file_type": "rationale", "source_file": "docs/superpowers/plans/2026-07-05-voice-first-kb-v2.md", "source_location": "Locked design decisions #2", "source_url": null, "captured_at": "2026-07-05", "author": null, "contributor": null, "rationale": "Uses client.responses.parse with Pydantic models for deterministic structured extraction. Requires openai>=1.66. FakeStructuredExtractor enables tests and keyless demo mode."}, {"id": "rationale_user_owned_prompts", "label": "User-Owned Editable Prompts", "file_type": "rationale", "source_file": "docs/superpowers/plans/2026-07-05-voice-first-kb-v2.md", "source_location": "Locked design decisions #3", "source_url": null, "captured_at": "2026-07-05", "author": null, "contributor": null, "rationale": "Prompts are markdown files at repo root (prompts/*.md), hot-read on every extraction request. No restart needed after edits. Exposed via REST API and admin-gated UI panel."}, {"id": "rationale_two_minute_limit", "label": "Two-Minute Duration Enforcement", "file_type": "rationale", "source_file": "docs/superpowers/plans/2026-07-05-voice-first-kb-v2.md", "source_location": "Locked design decisions #4", "source_url": null, "captured_at": "2026-07-05", "author": null, "contributor": null, "rationale": "Enforced client-side (MediaRecorder auto-stop at 120s) and server-side (PyAV probes container duration, rejects >120s with HTTP 422 before transcription). Defense in depth."}, {"id": "rationale_e2e_only_testing", "label": "E2E-Only Testing Philosophy", "file_type": "rationale", "source_file": "docs/superpowers/plans/2026-07-05-voice-first-kb-v2.md", "source_location": "Locked design decisions #6", "source_url": null, "captured_at": "2026-07-05", "author": null, "contributor": null, "rationale": "No unit tests. Module tasks get runnable smoke-verification commands. Correctness proven by API-level pipeline tests (real SAPI speech, real whisper, real store) and Playwright browser tests (fake microphone). GitHub mocked with respx for determinism."}, {"id": "rationale_design_led_frontend", "label": "Design-Led Frontend Approach", "file_type": "rationale", "source_file": "docs/superpowers/plans/2026-07-05-voice-first-kb-v2.md", "source_location": "Locked design decisions #7", "source_url": null, "captured_at": "2026-07-05", "author": null, "contributor": null, "rationale": "Frontend uses frontend-design skill for visual direction, then impeccable skill for polish. ID contract keeps Playwright tests decoupled from visual iteration. Vanilla ES modules, no build step."}], "edges": [{"source": "app_server", "target": "pkg_kb_core", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/plans/2026-07-05-voice-first-kb-v2.md", "source_location": "Task 10", "weight": 1.0}, {"source": "app_server", "target": "pkg_voice_transcribe", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/plans/2026-07-05-voice-first-kb-v2.md", "source_location": "Task 10", "weight": 1.0}, {"source": "app_server", "target"